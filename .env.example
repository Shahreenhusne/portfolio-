# PostgreSQL connection string used by Prisma.
# See postgressql.docker.txt for how to stand up Postgres locally or via Docker.
# DATABASE_URL="postgresql://username:password@localhost:5432/database_name"

 DATABASE_URL: "postgresql://postgres:postgres@db:5432/portfolio"

# Resend API key (https://resend.com) used to send contact form emails.
RESEND_API_KEY="your_resend_api_key"

# Where contact form messages should be delivered.
CONTACT_TO_EMAIL="arparabbani@gmail.com"

# Sender address for outgoing contact form emails.
# "onboarding@resend.dev" works out of the box without a verified domain,
# but only delivers to the Resend account's own email during testing.
CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"
